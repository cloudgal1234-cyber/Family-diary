{
  "rules": {
    "families": {
      "$familyId": {

        ".read":  "auth != null && root.child('families/' + $familyId + '/users/' + auth.uid).exists()",
        ".write": "auth != null && root.child('families/' + $familyId + '/users/' + auth.uid).exists()",

        "events": {
          "$eventId": {
            ".validate": "newData.hasChildren(['id', 'title', 'category', 'status', 'created_by'])",

            "category": {
              ".validate": "newData.val() === 'CHUGIM' || newData.val() === 'HOMEWORK' || newData.val() === 'FAMILY' || newData.val() === 'FRIENDS' || newData.val() === 'OTHER'"
            },
            "status": {
              ".validate": "newData.val() === 'ON_TIME' || newData.val() === 'MOVED' || newData.val() === 'CANCELED' || newData.val() === 'RESCHEDULED' || newData.val() === 'POSTPONED'"
            }
          }
        },

        "tasks": {
          "$taskId": {
            ".validate": "newData.hasChildren(['id', 'title', 'status', 'created_by'])",

            "status": {
              ".validate": "newData.val() === 'PENDING' || newData.val() === 'IN_PROGRESS' || newData.val() === 'DONE' || newData.val() === 'SKIPPED'"
            },
            "priority": {
              ".validate": "newData.val() === 'LOW' || newData.val() === 'MEDIUM' || newData.val() === 'HIGH' || newData.val() === 'URGENT'"
            }
          }
        },

        "users": {
          "$userId": {
            ".write": "auth.uid === $userId || root.child('families/' + $familyId + '/users/' + auth.uid + '/role').val() === 'PARENT'"
          }
        },

        "notifications": {
          "$notifId": {
            ".write": "auth != null && root.child('families/' + $familyId + '/users/' + auth.uid).exists()"
          }
        }

      }
    }
  }
}
